# Public site URL, used for Stripe redirects and metadata. No trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Support address shown in the app and legal pages. Leave empty to hide.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Pro (optional) ----
# Set to true only after the Stripe values below are configured. When false, every feature is free.
NEXT_PUBLIC_PRO_ENABLED=false
# Shown on upgrade buttons. Must match the Stripe price exactly, or leave empty to show none.
NEXT_PUBLIC_PRO_PRICE_LABEL=$19 once

# Server only. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# payment (one time purchase) or subscription
STRIPE_MODE=payment
# Optional free trial length for subscriptions
STRIPE_TRIAL_DAYS=
# Random string, 32+ characters. Signs license keys. Changing it invalidates every issued key.
# Generate with: openssl rand -base64 48
LICENSE_SECRET=
