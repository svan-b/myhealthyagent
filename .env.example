# Public site URL, used for Stripe redirects and metadata. No trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Support address shown in the app and legal pages. Leave empty to hide.
# If you sell Pro, set this, the portal link below, or both, so buyers can get help and cancel.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Pro (optional) ----
# Set to true only after the Stripe values below are configured. When false, every feature is free.
NEXT_PUBLIC_PRO_ENABLED=false
# Shown on upgrade buttons. Must match the Stripe price exactly, or leave empty to show none.
# In .env files write $ as \$, because Next.js reads $19 as a variable and would drop it.
# In a hosting dashboard such as Vercel, type the price without the backslash.
NEXT_PUBLIC_PRO_PRICE_LABEL=\$19 once
# Stripe's customer portal login link (Stripe Dashboard, Settings, Billing, Customer portal).
# "Manage billing" opens it. Stripe emails people a one time code, so no license key is needed.
NEXT_PUBLIC_STRIPE_PORTAL_LOGIN_URL=

# Server only. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# payment (one time purchase) or subscription
STRIPE_MODE=payment
# Optional free trial length for subscriptions
STRIPE_TRIAL_DAYS=
# Random string, 32+ characters. Signs license keys. Changing it invalidates every issued key.
# Use a different one while you test with sk_test_ keys, or set LICENSE_VALID_FROM when you go live.
# Generate with: openssl rand -base64 48
LICENSE_SECRET=
# Optional. Keys issued before this time stop working, for example 2026-12-01T00:00:00Z.
# Set it to the moment you switch to live keys so keys from test purchases are not accepted.
LICENSE_VALID_FROM=
# Optional. Comma separated Stripe customer ids (cus_...), subscription ids (sub_...) or checkout
# session ids (cs_...) whose license keys should stop working, for example a key posted online.
LICENSE_REVOKED=
# Optional. How many of your own proxies add an entry to X-Forwarded-For, used for rate limits.
# The default, 1, fits Vercel and a single nginx, Caddy or load balancer in front of the app.
TRUSTED_PROXY_HOPS=
